# LLM provider: openai | ollama (on-prem SLM via Ollama)
MA_RAG_LLM_PROVIDER=ollama

# --- OpenAI (when MA_RAG_LLM_PROVIDER=openai) ---
OPENAI_API_KEY=your_openai_api_key_here
MODEL_NAME=gpt-4o-mini
# Legacy alias still supported in code:
# API_KEY=your_openai_api_key_here

# --- Ollama SLM (when MA_RAG_LLM_PROVIDER=ollama) ---
# Install: https://ollama.com — then: ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Paths (optional — defaults shown)
# MA_RAG_DATA_DIR=./data
# MA_RAG_LOCAL_INDEX_DIR=./local_index
# MA_RAG_INDEX_DIR=./save_embs/gte-ml-base
# MA_RAG_INDEX_DATASET=dpr100
# Local ingestion defaults to hashing: no model download, CPU-only, stable on macOS.
# Set to sentence-transformers only when you want neural embeddings.
# MA_RAG_LOCAL_EMBEDDING_BACKEND=hashing
# MA_RAG_EMBEDDING_MODEL=Alibaba-NLP/gte-multilingual-base
# MA_RAG_LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# MA_RAG_PUBMED_CORPUS=./data/pubmed.tsv.gz

# Device: auto | cpu | cuda:0 | mps
# MA_RAG_DEVICE=auto

# FAISS: auto | 0 | 1  (auto uses GPU only when available)
# MA_RAG_USE_FAISS_GPU=auto
